# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - BACKEND FLASK (ROTA FACIL SP)
# ==============================================================================

# Porta da API Flask (Render e Railway injetam automaticamente os.environ['PORT'])
PORT=5000
FLASK_ENV=development

# Conexão com o Banco de Dados MySQL (Host local ou Nuvem)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=rota_facil_sp

# Alternativa: URL de conexão unificada (padrão Render / Railway / AWS)
# MYSQL_URL=mysql://root:senha@localhost:3306/rota_facil_sp
